# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

node_modules
dist
dist-ssr
*.local

# ------------------------------------------------------------------
# Secretos. Esto NUNCA se sube al repo.
# El .env local lo completás vos con tus claves.
# ------------------------------------------------------------------
.env
.env.*
!.env.example

# Credenciales del service account de Firebase (descargadas de la consola).
#
# OJO: el nombre real que baja la consola es
#   <proyecto>-firebase-adminsdk-<hash>.json
# Los patrones de abajo cubren ese nombre Y los nombres de archivo a mano.
# Antes sólo estaban *service-account*.json y serviceAccount*.json, que no
# matchean el nombre de Firebase: el archivo quedaba untracked pero NO
# ignorado, a un `git add -A` de ser publicado en un repo público.
*adminsdk*.json
*-firebase-adminsdk-*.json
*service-account*.json
serviceAccount*.json
service_account*.json
credentials*.json
# Y por si alguien guarda la clave en la raíz con otro nombre:
*-service-account.json
secret*.json

# Salida del build del widget: se genera, no se versiona
public/widget/

# Vercel
.vercel

# JRE portable para los emuladores de Firebase (se descarga, no se versiona).
# Es un .tar de 50 MB que no tiene nada que ver con el código.
.tools/

# Salidas de los emuladores
.emulator-data/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# El `vercel link` agrega un ".env*" acá. NO se deja: el patrón es más
# ancho que las reglas de arriba y matchea .env.example, que como último
# patrón gana mata la negación "!.env.example". Con las reglas de arriba
# (.env, .env.*, !.env.example) el OIDC token que escribe el CLI igual
# queda cubierto, y el ejemplo sigue versionable.
