rules_version = '2';

// ==================================================================
//  REGLAS DE SEGURIDAD — la frontera real del sistema
// ==================================================================
//  Todo lo que hay en el frontend es PELIGROSO por definición. El
//  navegador es del visitante, y un visitante puede abrir la consola
//  y llamar al SDK de Firebase a mano con lo que quiera.
//
//  Si una operación no está permitida explícitamente acá, está
//  denegada. No hay ningún `allow read, write: if true` en este archivo
//  y ese es el motivo por el que el archivo entero tiene sentido.
//
//  Las tres invariantes que tienen que quedar garantizadas:
//
//   1. Un organizador sólo lee y escribe sus propios datos.
//   2. El cliente NUNCA escribe un /registros: eso lo hace el backend
//      con el Admin SDK, que además valida capacidad y genera el QR.
//   3. El interruptor del plan no lo puede tocar el propio cliente,
//      ni al crearse la cuenta ni después. Si pudiera, cualquier
//      organizador se autopromovería a pro+ editando su documento.
//   4. Los campos que el backend necesita exclusively —el contador
//      `reservas` del evento— tampoco los puede tocar el dueño. Mismo
//      motivo que el 3, y por el mismo patrón de comparación.
//
//  Las pruebas de esto están en tests/rules/ y se ejecutan contra el
//  emulador, sin tocar el proyecto real. `npm run test:rules`.
//
//  Las pruebas de esto están en tests/rules/ y se ejecutan contra el
//  emulador, sin tocar el proyecto real. `npm run test:rules`.
// ==================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================
    //  Funciones
    // ==============================================================

    function estaAutenticado() {
      return request.auth != null;
    }

    // El super-admin se marca con un custom claim, no con un campo de
    // un documento: es la única forma de que las reglas no tengan que
    // consultar la base para decidir, y no se puede falsificar desde el
    // cliente.
    //
    // OJO con el `in` de adentro. `request.auth.token.admin` a secas NO
    // devuelve null cuando el claim no existe: LANZA error, y un error
    // dentro de una regla deniega la operación entera. Como casi
    // ningún organizador tiene el claim, sin el `in` esto reventaría
    // todos los `esSuperAdmin() || loMio()`: el lado izquierdo explota
    // y se deniega aunque el usuario sea legítimo. El `in` lo hace
    // fallar en falso, que es lo correcto.
    function esSuperAdmin() {
      return estaAutenticado()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    // `get()` sobre un documento inexistente devuelve un Document cuyo
    // `.data` es null. OJO con las dos trampas de acá:
    //
    //  1. El lenguaje de reglas NO tiene `exists()`.
    //     `get(...).exists()` compila pero al evaluarlo tira
    //     "Function not found error: Name: [exists]", y ese error
    //     deniega la operación. La forma correcta de preguntar por
    //     existencia es comparar `.data != null`.
    //
    //  2. Una función NO puede devolver el resultado de un get().
    //     Si la función lo devuelve y el llamador hace `org.data`, el
    //     Document llega como null y revienta con "Null value error".
    //     Por eso el get() va inline en un `let`, no en un helper.
    function organizacionActiva() {
      let org = get(/databases/$(database)/documents/organizadores/$(request.auth.uid));
      return estaAutenticado()
        && org.data != null
        && org.data.estadoSuscripcion == 'activo';
    }

    // El documento /registros/{id} NO tiene campo organizadorId (a
    // propósito: se lo agrega el atacante y auto-asigna el registro).
    // Para saber de quién es hay que saltar al evento padre. Este salto
    // es el motivo por el que /registros no se puede filtrar con un
    // where() barato: cada documento evaluado paga un get() extra.
    function perteneceAlOrganizadorDelEvento(eventoId) {
      let evento = get(/databases/$(database)/documents/eventos/$(eventoId));
      return evento.data != null && evento.data.organizadorId == request.auth.uid;
    }

    // ==============================================================
    //  /organizadores/{uid}
    // ==============================================================
    match /organizadores/{uid} {

      function esPropio() {
        return estaAutenticado() && request.auth.uid == uid;
      }

      // La propiedad de seguridad, enunciada como igualdad y no como
      // lista blanca. Importa la diferencia:
      //
      //   affectedKeys().hasOnly([...])  →  si el diff está VACÍO,
      //   hasOnly([]) devuelve true, o sea que un update que no cambia
      //   nada pasa. Y un set() que se olvide de mandar `plan` lo
      //   sobreescribe con null sin que se note en el diff.
      //
      // Comparar los campos privilegiados contra el valor actual es
      // "falla cerrada": cualquier intento de tocarlos se deniega,
      // venga de un update parcial o de un set() completo. Después, el
      // hasOnly agrega la forma: no se pueden agregar campos nuevos
      // (un `esAdmin: true` inventado tampoco pasa, aunque hoy nadie
      // lo leería).
      function noCambiaPrivilegios() {
        return request.resource.data.plan == resource.data.plan
          && request.resource.data.estadoSuscripcion == resource.data.estadoSuscripcion
          && request.resource.data.limitesPersonalizacion == resource.data.limitesPersonalizacion
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email;
      }

      // Lo único que el dueño controla de su propia cuenta.
      function soloCamposPermitidos() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre', 'brandingPanel']);
      }

      // Condiciones del alta. Acá está replicado LIMITES_POR_PLAN.gratis
      // de src/shared/types.ts, porque las reglas no pueden importar
      // TypeScript. La sincronía entre los dos no es a ojo:
      // tests/rules/aislamiento.test.ts crea la cuenta con los valores
      // de la tabla de TypeScript, así que si cambiás una y no la otra,
      // el test falla.
      function altaValida() {
        return request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.get('email', '')
          && request.resource.data.plan == 'gratis'
          && request.resource.data.estadoSuscripcion == 'activo'
          && request.resource.data.limitesPersonalizacion != null
          && request.resource.data.limitesPersonalizacion.bannerPermitido == false
          && request.resource.data.limitesPersonalizacion.colorPersonalizadoPermitido == true
          && request.resource.data.limitesPersonalizacion.logoPermitido == false
          && request.resource.data.limitesPersonalizacion.capacidadMaximaPorEvento == 100;
      }

      // ==================================================================
      //  Los límites de marca, aplicados de verdad
      // ==================================================================
      //
      //  `soloCamposPermitidos` deja editar `brandingPanel` entero, y
      //  hasta ahora nada miraba `limitesPersonalizacion` al hacerlo. O
      //  sea que los tres interruptores eran decorativos: un plan gratis
      //  podía poner un logo desde la consola con
      //
      //      updateDoc(doc(db,'organizadores',uid),
      //                {'brandingPanel.logoUrl':'https://…'})
      //
      //  y la UI que respeta los límites no alcanzaba: la UI es el lugar
      //  donde uno se porta bien, las reglas son donde no.
      //
      //  Los límites se LEEN del documento del propio organizador con un
      //  get(), en vez de hardcodear la tabla como hace altaValida().
      //  Con el get() una excepción comercial del super-admin se
      //  respeta sin tocar código: alcanza con cambiarle el campo al
      //  cliente, y la regla lo lee.
      //
      //  El get() va inline en un `let` porque una función no puede
      //  devolver un get() (ver la nota de organizacionActiva()).
      // El "o" es lo importante: O te dejan cambiar el color, O el color
      // tiene que seguir siendo el de ahora. Si se escribiera
      // `lim.colorPersonalizadoPermitido &&` a secas, el plan gratis —que
      // es el único que tiene colorPersonalizadoPermitido en true— nunca
      // podría cambiarlo, que es exactamente lo contrario de lo que
      // ofrece el plan.
      //
      //  bannerPermitido no aparece acá a propósito: brandingPanel no
      //  tiene bannerUrl. El banner vive en el evento (personalizacion),
      //  y lo limita la Fase 3.
      function respetaLimitesDeMarca() {
        let lim = get(/databases/$(database)/documents/organizadores/$(request.auth.uid)).data.limitesPersonalizacion;
        return lim != null
          && (lim.colorPersonalizadoPermitido
              || request.resource.data.brandingPanel.colorPrimario == resource.data.brandingPanel.colorPrimario)
          && (lim.colorPersonalizadoPermitido
              || request.resource.data.brandingPanel.colorSecundario == resource.data.brandingPanel.colorSecundario);
      }

      // El logo tiene su propio permiso porque es el único de los tres
      // que está detrás de un plan pago: pro+ y no antes.
      //
      // La comparación es contra `resource.data`, no contra null. Es lo
      // que hace que un logo concedido por excepción comercial no se
      // pierda: si el plan no lo permite, el valor tiene que SEGUIR SIENDO
      // el que ya está, no tiene que volver a null. Si comparáramos
      // contra null obligaríamos al super-admin a tocar las reglas cada
      // vez que otorga una excepción.
      function respetaLimiteDeLogo() {
        let lim = get(/databases/$(database)/documents/organizadores/$(request.auth.uid)).data.limitesPersonalizacion;
        return lim != null
          && (lim.logoPermitido
              || request.resource.data.brandingPanel.logoUrl == resource.data.brandingPanel.logoUrl);
      }

      allow get: if esPropio() || esSuperAdmin();
      allow list: if esSuperAdmin();

      // El super-admin también da de alta: es como se corrige a mano una
      // cuenta a la que el alta automática no llegó (Fase 8).
      allow create: if esSuperAdmin() || (esPropio() && altaValida());

      // esSuperAdmin() queda por fuera de las dos reglas de marca a
      // propósito: es quien otorga las excepciones, no debería estar
      // sujeto a ellas.
      allow update: if esSuperAdmin()
                    || (esPropio() && noCambiaPrivilegios() && soloCamposPermitidos()
                        && respetaLimitesDeMarca() && respetaLimiteDeLogo());

      // Borrar la cuenta propia está permitido: el borrado real con
      // cascada (eventos, registros, Auth) lo hace DELETE /api/me en el
      // backend con el Admin SDK. Lo que esta regla impide es borrar
      // cuentas AJENAS: B no toca lo de A.
      allow delete: if esSuperAdmin() || esPropio();
    }

    // ==============================================================
    //  /eventos/{eventoId}
    // ==============================================================
    match /eventos/{eventoId} {

      // En update se lee resource.data (el valor actual). En create NO
      // existe todavía y hay que leer request.resource.data. Es el
      // error clásico: usar resource.data en un create deniega todo.
      function esMio() {
        return organizacionActiva() && resource.data.organizadorId == request.auth.uid;
      }

      function loCreoComoMio() {
        return request.resource.data.organizadorId == request.auth.uid;
      }

      function noCambiaDueno() {
        return resource.data.organizadorId == request.resource.data.organizadorId;
      }

      // ==================================================================
      //  La capacidad máxima no depende de que el cliente se porte bien
      // ==================================================================
      //
      //  `capacidadMaxima` es un número que el organizador elige, y sin
      //  este chequeo un plan gratis puede abrir un evento de un millón
      //  de entradas. La UI lo valida, pero la UI es sólo donde uno se
      //  porta bien.
      //
      //  El tope se lee del documento del organizador con un get(), que
      //  es lo que hace que valga la excepción comercial: si el
      //  super-admin le sube capacidadMaximaPorEvento a un cliente, la
      //  regla lo levanta sin deployar nada.
      //
      //  Lo que NO se puede hacer acá es limitar la CANTIDAD de eventos
      //  (eventosMaximos): el lenguaje de reglas no tiene count(), así
      //  que no hay forma de preguntar cuántos documentos tiene un
      //  organizador desde una regla. Si algún día hace falta, va por un
      //  contador en el doc del organizador o por el backend de la Fase 3.
      //
      //  OJO con el `is int`, que para algo distinto de lo que parece:
      //  comparar cosas de tipos distintos en el motor de reglas da FALSE
      //  en vez de coercionar, así que una capacidad que llega como texto
      //  ya queda afuera por el `<= lim.capacidadMaximaPorEvento` de
      //  abajo y el `is int` no hace nada por eso.
      //
      //  Lo que sí atrapa es un float POR DEBAJO del límite: 99.5 es
      //  `<= 100`, así que sin el `is int` un plan gratis podría abrir un
      //  evento de 99,5 entradas y el cupo se vuelve fraccional. Hay un
      //  test de eso. Y >0 porque una capacidad de cero es un evento que
      //  no existe.
      function capacidadDentroDelPlan() {
        let lim = get(/databases/$(database)/documents/organizadores/$(request.auth.uid)).data.limitesPersonalizacion;
        return lim != null
          && request.resource.data.capacidadMaxima is int
          && request.resource.data.capacidadMaxima > 0
          && request.resource.data.capacidadMaxima <= lim.capacidadMaximaPorEvento;
      }

      // Para list, las reglas se evalúan documento por documento: un
      // where('organizadorId','==',uid) sólo devuelve los suyos, y un
      // list() sin filtro no devuelve nada. Por eso no hace falta
      // filtrar en el cliente: las reglas ya no dejan pasar los ajenos.
      // ==================================================================
      //  La personalización del evento también la limita el plan
      // ==================================================================
      //
      //  Misma forma que `respetaLimitesDeMarca()` y `respetaLimiteDeLogo()`
      //  del /organizadores, pero del otro lado: el logo del PANEL vive en
      //  `brandingPanel`, y el banner y el logo del EVENTO viven en
      //  `personalizacion`, que es la que pinta la landing /e/:eventoId.
      //
      //  Sin esto, `bannerPermitido` y `logoPermitido` seguían siendo
      //  decorativos para el evento, igual que lo eran para el panel antes
      //  de la Fase 2: un plan gratis escribía
      //
      //      updateDoc(doc(db,'eventos',id), {personalizacion:{logoUrl:'https://…'}})
      //
      //  y la landing lo pintaba. Es el mismo bug, en la otra colección.
      //  Y es la deuda que el propio archivo anotaba: "El banner vive en
      //  el evento (personalizacion), y lo limita la Fase 3".
      //
      //  Por qué compara contra `resource.data` y no contra null: una
      //  excepción comercial concedida tiene que sobrevivir a los
      //  borrados posteriores. Si la regla dijera "si no está permitido,
      //  el logo tiene que ser null", el siguiente guardado de cualquier
      //  otro campo borraría el logo que el super-admin habilitó.
      //
      //  Por qué no valida que el color sea un hex: el lenguaje de reglas
      //  no tiene ni regex ni forma de medir un string. Lo que sí se
      //  puede—that es lo que importa— es que el valor siga siendo el
      //  mismo tipo. Un color basura lo ignora `aplicarTema()` del lado
      //  del cliente en vez de romper el layout.
      //
      //  OJO con los `Map.get` con default, que acá SÍ hacen falta y en
      //  `esMio()` parecían opcionales: `updateDoc` NO mergea en
      //  profundidad, REEMPLAZA el mapa entero. Un
      //  `updateDoc(..., {personalizacion:{bannerUrl:'…'}})` deja
      //  `request.resource.data.personalizacion` con una sola clave, y
      //  leer `.logoUrl` sobre un objeto que no lo tiene LANZA error y
      //  deniega la operación. Sin el default, poner un banner en un plan
      //  que lo permite fallaría justamente por el campo que el permiso
      //  deja tocar.
      //
      //  El default además deja la reglaanziuesta: lo que evalúa es
      //  exactamente "cambió un campo que no podía cambiar", y no "mandó
      //  el objeto completo".
      function respetaLimitesDePersonalizacion() {
        let lim = get(/databases/$(database)/documents/organizadores/$(request.auth.uid)).data.limitesPersonalizacion;
        let antes = resource.data.get('personalizacion', {});
        let despues = request.resource.data.get('personalizacion', {});
        return lim != null
          && (lim.colorPersonalizadoPermitido
              || despues.get('colorPrimario', null) == antes.get('colorPrimario', null))
          && (lim.colorPersonalizadoPermitido
              || despues.get('colorSecundario', null) == antes.get('colorSecundario', null))
          && (lim.bannerPermitido
              || despues.get('bannerUrl', null) == antes.get('bannerUrl', null))
          && (lim.logoPermitido
              || despues.get('logoUrl', null) == antes.get('logoUrl', null));
      }

      // ==================================================================
      //  El contador de reservas es del servidor, no del organizador
      // ==================================================================
      //
      //  `allow update` es `esMio() && noCambiaDueno()`, o sea que el
      //  dueño de un evento puede escribir CUALQUIER campo del suyo que no
      //  sea el dueño. Eso incluye el contador que la transacción de
      //  /api/registro usa para no sobrepasar la capacidad:
      //
      //      updateDoc(doc(db,'eventos',id), { reservas: -1000 })
      //
      //  abría el cupo del propio evento. Comparar contra
      //  `resource.data` es la forma de "falla cerrada" que ya usa
      //  `noCambiaPrivilegios()`: da igual que el update sea parcial o un
      //  setDoc completo, tocar el contador se deniega.
      //
      //  El `get(..., 0)` con default no es paranoia: los eventos creados
      //  antes de la Fase 3 NO tienen el campo, y leer una propiedad
      //  inexistente LANZA error en vez de devolver null (es la misma
      //  trampa del `organizadorId` en el list de más abajo). Sin el
      //  default, editar el nombre de un evento viejo lo dejaría
      //  ineditable.
      function noCambiaReservas() {
        return request.resource.data.get('reservas', 0) == resource.data.get('reservas', 0);
      }

      allow get: if esSuperAdmin() || esMio();
      // El `.get('organizadorId', null)` en lugar de
      // `resource.data.organizadorId` es a propósito. En un list() sin
      // filtro el motor llega a evaluar la regla contra un recurso que
      // no tiene ese campo, y leer una propiedad inexistente LANZA
      // error en vez de devolver null; ese error deniega el list
      // entero con un "Property organizadorId is undefined" que no
      // dice nada. Map.get con valor por defecto devuelve null, la
      // comparación falla en falso y el documento queda fuera, que es
      // la respuesta correcta.
      allow list: if esSuperAdmin()
                  || (organizacionActiva()
                      && resource.data.get('organizadorId', null) == request.auth.uid);

      // Por qué NO se reutiliza `capacidadDentroDelPlan()` en el update,
      // que es la tentación obvious: produciría un bloqueo real. Si un
      // organizador tuvo una excepción de 1.000, abrió un evento de 1.000
      // y el super-admin le saca la excepción, el evento queda con 1.000 y
      // un tope de nuevo de 100. Con la regla del create, CUALQUIER
      // update de ese evento se deniega —incluido el que lo baja a 50—
      // porque el resultado sigue estando por encima del plan. El evento
      // queda congelado y el organizador no tiene ninguna forma de
      // sacarlo de ahí.
      //
      //  Lo que la regla de verdad quiere decir es "subir la capacidad por
      // encima del plan está prohibido", no "el evento tiene que estar
      // siempre dentro del plan". Por eso la condición es: si la capacidad
      // baja (o queda igual), pasa siempre; si sube, tiene que entrar en
      // el tope. Bajar es siempre una operación legítima —se vendieron 80
      // de 100 y achicás el evento— y no puede quedar trancada.
      //  Ni el `is int` ni el `> 0` de `capacidadDentroDelPlan()` van
      //  acá, y en los dos casos es porque la rama es inalcanzable para
      //  ellos. Sólo se llega a esta rama cuando la capacidad SUBE, o sea
      //  cuando es mayor que la que ya tenía: un float como 99.5 nunca
      //  sube, y un cero nunca sube. Y para los tipos raros —un string
      //  "200", un float 150.5— el `<= lim.capacidadMaximaPorEvento`
      //  alcanza solo, porque comparar tipos distintos da FALSE. Dejar
      //  condiciones que no se pueden alcanzar es ruido: dice que se
      //  chequea algo que no se chequea.
      function subirCapacidadRespetaElPlan() {
        let lim = get(/databases/$(database)/documents/organizadores/$(request.auth.uid)).data.limitesPersonalizacion;
        return request.resource.data.capacidadMaxima <= resource.data.capacidadMaxima
          || (lim != null
              && request.resource.data.capacidadMaxima <= lim.capacidadMaximaPorEvento);
      }

      // En el create, "no permitido" significa null y no "igual que ahora",
      // porque no hay valor anterior con el cual comparar. Es la misma
      // distinción entre create y update que ya aparece arriba, en la nota
      // de `esMio()`: en create se lee request.resource.data, en update se
      // leen los dos.
      function personalizacionAltaValida() {
        let lim = get(/databases/$(database)/documents/organizadores/$(request.auth.uid)).data.limitesPersonalizacion;
        let alta = request.resource.data.get('personalizacion', {});
        return lim != null
          && (lim.colorPersonalizadoPermitido || alta.get('colorPrimario', null) == null)
          && (lim.colorPersonalizadoPermitido || alta.get('colorSecundario', null) == null)
          && (lim.bannerPermitido || alta.get('bannerUrl', null) == null)
          && (lim.logoPermitido || alta.get('logoUrl', null) == null);
      }

      // ==================================================================
      //  Código corto, slug y visibilidad: nacen con el evento
      // ==================================================================
      //
      //  `codigoCorto` es el id público del evento (lo que se comparte y
      //  lo que entiende el buscador). Viaja como campo ADEMÁS de ser el
      //  id del documento en el alta por API, para que la UI no tenga que
      //  distinguir "evento nuevo" de "evento viejo": lee el campo.
      //
      //  La unicidad NO se puede validar en reglas (no hay count ni
      //  consultas de existencia sobre otro documento): la impone el
      //  backend con transacción (POST /api/eventos). Acá sólo se exige
      //  forma: string no vacío y visibilidad en el vocabulario.
      //
      //  Una vez puesto, el código y el slug NO cambian: un QR impreso o
      //  un link compartido apuntan a ese valor. El `nombreNormalizado`
      //  SÍ viaja con el nombre (lo mantiene `actualizarEvento`), porque
      //  si no el evento renombrado desaparece del buscador.
      function identidadAltaValida() {
        return request.resource.data.codigoCorto is string
          && request.resource.data.codigoCorto.size() > 0
          && request.resource.data.nombreNormalizado is string
          && request.resource.data.slug is string
          && request.resource.data.slug.size() > 0
          && (request.resource.data.visibilidad == 'publico'
              || request.resource.data.visibilidad == 'privado');
      }

      // "No cambia una vez puesto, pero se puede poner si falta": los
      // eventos creados antes del código corto no tienen el campo, y sin
      // esta rama quedarían ineditables (mismo patrón que `noCambiaReservas`
      // con su default).
      function noCambiaIdentidad() {
        return (resource.data.get('codigoCorto', null) == null
                || request.resource.data.get('codigoCorto', null) == resource.data.get('codigoCorto', null))
          && (resource.data.get('slug', null) == null
              || request.resource.data.get('slug', null) == resource.data.get('slug', null));
      }

      allow create: if esSuperAdmin()
                    || (organizacionActiva() && loCreoComoMio()
                        && request.resource.data.estado == 'activo'
                        && request.resource.data.get('reservas', 0) == 0
                        && capacidadDentroDelPlan()
                        && personalizacionAltaValida()
                        && identidadAltaValida());

      allow update: if esSuperAdmin()
                    || (esMio() && noCambiaDueno()
                        && noCambiaReservas()
                        && noCambiaIdentidad()
                        && subirCapacidadRespetaElPlan()
                        && respetaLimitesDePersonalizacion());
      allow delete: if esSuperAdmin() || esMio();
    }

    // ==============================================================
    //  /registros/{registroId}
    // ==============================================================
    match /registros/{registroId} {

      function perteneceAlOrganizadorDelRegistro() {
        return organizacionActiva() && perteneceAlOrganizadorDelEvento(resource.data.eventoId);
      }

      // El organizador puede aprobar, rechazar, editar los datos de
      // contacto y borrar. NO puede tocar `usado` ni `fechaUso`: eso lo
      // escribe la transacción de la Fase 7, y si el organizador
      // pudiera marcar unUsed=false, podría reutilizar entradas.
      // Tampoco puede mover el registro a otro evento.
      function soloCamposDelOrganizador() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'nombre', 'email', 'telefono']);
      }

      allow get: if esSuperAdmin() || perteneceAlOrganizadorDelRegistro();
      allow list: if esSuperAdmin() || perteneceAlOrganizadorDelRegistro();

      // El alta del registro pasa por /api/registro con el Admin SDK:
      // es el único que puede generar el QR, verificar la capacidad
      // máxima y mandar el mail. Abrir el create acá sería abrir un
      // formulario público de escritura sin control de spam.
      allow create: if false;

      allow update: if esSuperAdmin()
                    || (perteneceAlOrganizadorDelRegistro() && soloCamposDelOrganizador());

      allow delete: if esSuperAdmin() || perteneceAlOrganizadorDelRegistro();
    }

    // Cualquier otra colección o subcolección queda denegada:
    // las reglas son de denegación por defecto, y acá no se declara
    // ninguna otra.
  }
}
