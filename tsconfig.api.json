{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node", "@vercel/node"],
    "skipLibCheck": true,

    /* Bundler mode: es lo más cercano a cómo se ejecuta /api/ en Vercel.
       OJO, la analogía es sólo para el typecheck. En producción NO es
       esbuild: Vercel transpila archivo por archivo y deja imports
       relativos sin resolver, que es exactamente lo que dispara el
       ERR_MODULE_NOT_FOUND de los imports sin extensión .js. */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
