# ==================================================================
# COPIÁ ESTO A .env.local  (cp .env.example .env.local)  Y COMPLETALO VOS.
# .env y .env.local están en .gitignore: nunca se suben al repo.
#
# OJO, y esto es importante: este archivo ES un ejemplo. Ninguna clave
# real vive acá, ni la de Firebase ni la de Gmail. Si algún día
# encontrás una clave real en un archivo versionado, esa clave está
# quemada: rotala en el panel del proveedor, no la borres del archivo
# y esperes que nadie la haya visto.
# ==================================================================
#
# REGLA DE ORO DE ESTE PROYECTO
#
#   Sólo las variables con prefijo VITE_ llegan al bundle del navegador.
#   Cualquier otra variable se queda en el servidor (/api/).
#
#   --> Si alguna vez creás una variable con prefijo VITE_,
#       asumí que queda publicada en Internet. Sin excepciones.
#
#   --> Y al revés: una variable SIN prefijo VITE_ en este archivo no
#       llega a ningún lado. Vite no la expone. Por eso las del
#       backend van a .env.local para `vercel dev` y a las variables
#       de entorno de Vercel para producción, nunca en un VITE_.
#

# ------------------------------------------------------------------
# 1. Firebase — config web
#    Console Firebase → Project Settings → General → Your apps → Web app
#    → SDK setup and configuration → Config
#
#    Sobre si esto es un secreto: la apiKey de Firebase NO lo es. Viaja
#    en el JS de cualquier visitante por diseño, y la seguridad real la
#    dan las reglas de Firestore, que es lo que programaste en
#    firestore.rules. Copiá los valores tal cual, sin comillas: en .env
#    no hacen falta y un valor entrecomillado queda con las comillas
#    adentro en algunos lectores.
#
#    Aun así van como placeholders acá: un ejemplo teaches a copiar y
#    pegar, y no quiero que nadie tome un ejemplo como fuente de
#    valores.
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=PEGÁ_AQUÍ_LA_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=easyeventqr-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=easyeventqr-dev
VITE_FIREBASE_APP_ID=PEGÁ_AQUÍ_EL_APP_ID

# ------------------------------------------------------------------
# 2. Emuladores locales
#
#    Poné "si" para que el frontend apunte a los emuladores en vez de
#    al proyecto real. Requiere tener `npm run emuladores` corriendo en
#    otra terminal: sin eso, la pantalla se queda cargando y el error
#    es de red, poco descriptivo.
#
#    Con el emulador de Auth, el login con Google es simulado: acepta
#    cualquier correo y devuelve un nombre y una foto fijos. Sirve para
#    probar el flujo entero sin tocar la consola de Firebase.
#
#    OJO: nunca pongas esto en el deploy. En producción el frontend
#    tiene que hablar con Firebase de verdad.
# ------------------------------------------------------------------
VITE_USAR_EMULADORES=no

# ------------------------------------------------------------------
# 3. Backend (/api/ en Vercel) — estos NO van en un archivo de este
#    tipo para producción, van en:
#    Vercel → Project → Settings → Environment Variables
#    Para desarrollo local, en .env.local, que Vercel CLI lee solo.
# ------------------------------------------------------------------
#
#  Service account de Firebase  (Project Settings → Service Accounts)
#  → Generate new private key. El JSON se descarga UNA sola vez.
#  → Va entero y en una sola línea, sin comillas ni saltos.
#  → scripts/preparar-service-account.mjs lo aplana por vos.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
#
#  Gmail SMTP (mail) — https://myaccount.google.com → Seguridad →
#  Verificación en 2 pasos (obligatoria) → Contraseñas de aplicaciones →
#  crear una para EasyEventQR. Son 16 letras: van con o sin espacios.
#
# GMAIL_USER=tu-cuenta@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# GMAIL_SENDER_NAME=EasyEventQR
#
#  Sobre el mail: si NO ponés estas variables, el registro funciona igual
#  y el mail se imprime en la consola de `vercel dev`. Ese es el modo para
#  probar el circuito entero sin mandar nada. Gmail permite unos 500
#  mails por día por cuenta.
#
# ------------------------------------------------------------------
# 3b. Origen público de la app
#
#  Con esto se arma la URL que codifica el QR y la que va en el mail. Si
#  no está, el servidor usa el dominio del despliegue (VERCEL_URL) y, como
#  último recurso, el header Host de la request.
#
#  Ponela igual, y sin barra final. La razón: el Host lo manda el cliente
#  y se puede falsear, así que es la única de las tres fuentes que no es
#  confiable en producción. Si el QR saliera apuntando a un Host
#  manipulado, los asistentes escanean un código que no existe y no hay
#  forma de recuperarlo.
# ------------------------------------------------------------------
# APP_URL=https://easyeventqr.vercel.app

# ------------------------------------------------------------------
# 4. Mercado Pago
#
# NO hay integración real todavía. Hay dos modos y el flag decide cuál:
#
#   MERCADOPAGO_SIMULADO=true  -> pantalla de checkout falsa en
#                                 /pago/simulado, con botones de
#                                 "aprobar" y "rechazar" a mano.
#                                 No se cobra nada. Sirve para demo y
#                                 para probar el circuito entero (QR,
#                                 mail, check-in) sin gastar.
#
#   (sin la variable)          -> los endpoints de pago responden 501 y
#                                 el flujo de eventos pagos no existe.
#
# OJO, esto está apagado a propósito. Con la simulación prendida en
# producción, cualquiera que tuviera el link de una reserva podría
# marcarse su propia entrada como pagada con un clic: no se pierde plata,
# pero el ticket gratis es el producto entero. Prendelo sólo para probar.
#
# No lo pongas en .env.local para "dejarlo andando": ponelo en el entorno
# de Vercel sólo mientras hacés la demo, y apagalo después.
# ------------------------------------------------------------------
MERCADOPAGO_SIMULADO=no
#
# Token de acceso de MP. Sólo lo va a usar la integración real, que
# todavía no está escrita. Va vacío mientras tanto.
MERCADOPAGO_ACCESS_TOKEN=
#
# Secreto con el que MP firma los webhooks (MP → "Tus integraciones" →
# "Webhooks de notifications"). Con esto configurado, el webhook exige
# firma HMAC válida y rechaza el camino sin firmar. Vacío = sin
# verificación de firma (que es lo mismo que el modo simulado, así que
# tampoco va junto en producción).
MERCADOPAGO_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# 5. Super-admin
#    El UID de Firebase Auth de la cuenta que va a ser super-admin.
#    Se obtiene en Firebase Console → Authentication → Users → copiar UID.
#    Sólo esa cuenta verá la ruta /admin y podrá cambiar planes.
#
#    SIN prefijo VITE_: es una variable de SERVIDOR. Con VITE_ viaja dentro
#    del bundle y cualquier visitante lo lee en el código fuente. Y aunque
#    hoy el frontend no la use, dejarla a mano es una trampa: el próximo que
#    la use para pintar un botón la filtra.
#    El chequeo real vive en api/me.ts y api/admin-organizadores.ts.
# ------------------------------------------------------------------
SUPER_ADMIN_UID=c4HRa54bB7XSEyOigo2fHqgTL4h1

# ------------------------------------------------------------------
# 6. Sentry (monitoreo)
#    Sin estas variables, nada se inicializa: la app corre idéntica.
#    SENTRY_DSN es de SERVIDOR (api/). VITE_SENTRY_DSN va al bundle del
#    cliente: es público por diseño, la protección la dan los orígenes
#    permitidos en el proyecto de Sentry.
# ------------------------------------------------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=

