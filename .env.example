# ==================================================================
# COPIÁ ESTE ARCHIVO A .env  (cp .env.example .env)  Y COMPLETALO VOS.
# .env está en .gitignore: nunca se sube al repo.
# ==================================================================
#
# REGLA DE ORO DE ESTE PROYECTO
#
#   Sólo las variables con prefijo VITE_ llegan al bundle del navegador.
#   Cualquier otra variable se queda en el servidor (/api/).
#
#   --> Si alguna vez creás una variable con prefijo VITE_,
#       asumí que queda publicada en Internet. Sin excepciones.
#

# ------------------------------------------------------------------
# 1. Firebase — config web
#    Console Firebase → Project Settings → General → Your apps → Web app
#    SDK setup and configuration → Config
#    Son datos PÚBLICOS por diseño: viajan en el JS de cualquier visitante.
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# 2. Backend (/api/ en Vercel) — estos NO van acá, van en Vercel.
#    Se listan como referencia. Configuralas en:
#    Vercel → Project → Settings → Environment Variables
#    Para desarrollo local, ponelas en .env.local.
# ------------------------------------------------------------------
#
#  Service account de Firebase  (Project Settings → Service Accounts)
#  -> Generate new private key -> pegá el JSON COMPLETO como valor.
#  -> scripts/preparar-service-account.mjs te ayuda a formatearlo.
FIREBASE_SERVICE_ACCOUNT=

#  Brevo (mail) — SMTP & API → API Keys → Create new API key (v3)
BREVO_API_KEY=
#  El remitente tiene que estar VERIFICADO en Brevo: Senders & IP → Senders
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EasyEventQR

# ------------------------------------------------------------------
# 3. Mercado Pago (Fase 5). Vacio en el MVP: el flujo corre en modo simulado.
# ------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
